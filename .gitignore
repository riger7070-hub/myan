# Wrangler 로컬 캐시 (절대 올리면 안 됨)
.wrangler/

# 실수로 생성된 빈 파일
main

# 환경변수 파일 (혹시 생성 시 대비)
.env
.env.local
.dev.vars

# OS 파일
.DS_Store
Thumbs.db

# 노드 모듈
node_modules/

# 빌드 출력
dist/

# 테스트가 worker.js 를 .mjs 로 임시 복사하는 자리 (test/load-worker.mjs 참고)
test/.tmp/

# Lock 파일 (package-lock.json은 배포 환경에 필요하므로 포함)
*.lock

# 아카이브 (git에 불필요)
myan-icons.zip

# 이 프로젝트와 무관한 별도 작업 폴더 (실수로 커밋됐던 것 제거, 재추가 방지)
buyma/

# ── 미니앱 빌드 산출물 ──
# granite build 가 만드는 것들. .ait 는 매 빌드마다 바뀌는 1.9MB 바이너리라
# 저장소에 넣으면 이력만 무겁게 한다. 배포는 로컬 빌드 → ait deploy 로 한다.
mini/dist/
mini/*.ait

# ── 인증서·개인키 (절대 올리면 안 됨) ──
# 저장소가 공개라 개인키가 한 번이라도 올라가면 되돌릴 수 없다(히스토리에 남고,
# 푸시된 순간 이미 크롤링 대상이다). 앱인토스 mTLS 인증서 압축을 저장소 폴더 안에
# 푼 적이 있어서 확실히 막아 둔다. 실제 키는 Cloudflare 가 보관하고,
# wrangler.toml 에는 참조용 certificate_id 만 둔다.
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx
toss*.zip
toss-cert/

# quick-mobile-test.js 가 뱉는 스크린샷.
# 루트는 통째로 정적 자산으로 서빙되므로(wrangler.toml 의 [assets]) 여기 커밋하면
# 홈·가입 화면 스크린샷이 그대로 공개된다. 실제로 셋이 올라가 있었다.
mobile-test-*.png

# 붙여넣기 대장.
#
# ⚠️ 이것 **하나만** 안 올린다. 사진을 통째로 품고 있어 3.2MB 인데, 글이나 사진을
#    고칠 때마다 3.2MB 짜리 덩어리가 새로 쌓인다. 몇 번만 고쳐도 저장소가 무거워진다.
#    만드는 재료(blog/*.txt, insta/*.png, blog/shots/*.png, 이 도구)는 모두 올라가
#    있으므로 `npm run blog` 한 번이면 똑같이 다시 나온다. 잃는 것이 없다.
#
#    나머지 자료 — 글, 카드, 실제 화면, 프로필 — 는 전부 올린다.
#    다른 기기에서 받아 바로 올릴 수 있어야 한다.
blog/blog-page.html
blog/before/
blog/사진/

# ── Claude Code 로컬 설정 ──
# 저장소 루트가 통째로 정적 자산으로 서빙되므로(wrangler.toml 의 [assets]) 여기 커밋하면
# 홈 디렉터리 경로가 박힌 설정이 그대로 공개된다. PC 마다 다른 값이라 공유할 것도 아니다.
.claude/
blog/토스 상품 이미지/
blog/product-image.html
blog/product-image_files/
tools/morning-log.txt
