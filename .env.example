# M;Y 安 환경변수 예시
# 실제 값은 .env 파일에 작성하고 .gitignore에 추가하세요

# Google OAuth Client ID (공개 가능)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Sheets Webhook URL (비공개)
VITE_SHEETS_ENDPOINT=https://script.google.com/macros/s/your-script-id/exec

# 관리자 이메일
VITE_ADMIN_EMAIL=admin@example.com
